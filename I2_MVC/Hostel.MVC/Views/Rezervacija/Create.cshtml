@model Hostel.MVC.Models.Rezervacija
@{ ViewData["Title"] = "Nova rezervacija"; }
<div class="page-header"><h2><i class="bi bi-calendar-plus me-2"></i>Nova rezervacija</h2></div>
<div class="row"><div class="col-md-7"><div class="card shadow-sm"><div class="card-body p-4">
  <form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <partial name="_RezervacijaFormPartial" model="Model" />
    <div class="d-flex gap-2"><button type="submit" class="btn btn-hostel"><i class="bi bi-save me-1"></i>Spremi rezervaciju</button><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Odustani</a></div>
  </form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@using Hostel.MVC.Helpers
@model Hostel.MVC.Models.Rezervacija
@{ ViewData["Title"] = "Detalji rezervacije"; }
<div class="page-header d-flex justify-content-between align-items-center">
  <h2><i class="bi bi-calendar-check me-2"></i>Detalji rezervacije</h2>
  <a asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i>Natrag</a>
</div>
<div class="row"><div class="col-md-6"><div class="card shadow-sm">
  <div class="card-header" style="background:var(--hostel-primary);color:white;"><h5 class="mb-0"><i class="bi bi-person me-2"></i>@Model.ImeGosta</h5></div>
  <div class="card-body">
    <table class="table table-borderless">
      <tr><td class="fw-semibold text-muted">Gost</td><td>@Model.ImeGosta</td></tr>
      <tr><td class="fw-semibold text-muted">E-mail</td><td>@Model.Email</td></tr>
      <tr><td class="fw-semibold text-muted">Ležaj</td><td>@Model.Lezaj?.Naziv (Soba @Model.Lezaj?.BrojSobe)</td></tr>
      <tr><td class="fw-semibold text-muted">Prijava</td><td>@Model.DatumPrijave.ToString("dd.MM.yyyy")</td></tr>
      <tr><td class="fw-semibold text-muted">Odjava</td><td>@Model.DatumOdjave.ToString("dd.MM.yyyy")</td></tr>
      <tr><td class="fw-semibold text-muted">Broj noći</td><td><strong>@Model.BrojNoci</strong></td></tr>
      <tr><td class="fw-semibold text-muted">Ukupno</td><td>@Html.FormatCijena(Model.UkupnaCijena)</td></tr>
      <tr><td class="fw-semibold text-muted">Status</td><td>@Html.StatusBadge(Model.Status)</td></tr>
    </table>
  </div>
  @if(User.Identity?.IsAuthenticated==true){<div class="card-footer d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil me-1"></i>Uredi</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>Obriši</a></div>}
</div></div></div>

@using Hostel.MVC.Helpers
@model IEnumerable<Hostel.MVC.Models.Rezervacija>
@{ ViewData["Title"] = "Rezervacije"; string naslov = ViewBag.Naslov ?? "Sve rezervacije"; }
<div class="page-header d-flex justify-content-between align-items-center">
  <h2><i class="bi bi-calendar-check-fill me-2"></i>@naslov</h2>
  @if(User.Identity?.IsAuthenticated==true){<a asp-action="Create" class="btn btn-hostel"><i class="bi bi-plus-lg me-1"></i>Nova rezervacija</a>}
</div>
<div class="mb-3 d-flex gap-2 flex-wrap">
  <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Sve</a>
  <a asp-action="Aktivne" class="btn btn-sm btn-outline-success">Aktivne</a>
  <a asp-action="Nadolazece" asp-route-dana="7" class="btn btn-sm btn-outline-primary">Nadolazeće (7 dana)</a>
  @if(User.Identity?.IsAuthenticated==true){<a asp-action="Moje" class="btn btn-sm btn-outline-warning">Moje rezervacije</a>}
</div>
<div class="table-responsive"><table class="table table-hover">
  <thead class="table-hostel"><tr><th>Gost</th><th>E-mail</th><th>Ležaj</th><th>Prijava</th><th>Odjava</th><th>Noći</th><th>Status</th><th>Akcije</th></tr></thead>
  <tbody>
    @foreach (var rez in Model) {
      <tr><td><strong>@rez.ImeGosta</strong></td><td class="small text-muted">@rez.Email</td><td>@rez.Lezaj?.Naziv</td>
      <td>@rez.DatumPrijave.ToString("dd.MM.yyyy")</td><td>@rez.DatumOdjave.ToString("dd.MM.yyyy")</td>
      <td class="text-center">@rez.BrojNoci</td><td>@Html.StatusBadge(rez.Status)</td>
      <td>
        <a asp-action="Details" asp-route-id="@rez.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
        @if(User.Identity?.IsAuthenticated==true){
          <a asp-action="Edit" asp-route-id="@rez.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
          <a asp-action="Delete" asp-route-id="@rez.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
        }
      </td></tr>
    }
  </tbody>
</table></div>
@if(!Model.Any()){<div class="alert alert-hostel"><i class="bi bi-info-circle me-2"></i>Nema rezervacija za prikaz.</div>}

@model Hostel.MVC.Models.Lezaj
<div class="mb-3"><label asp-for="Naziv" class="form-label fw-semibold"></label><input asp-for="Naziv" class="form-control" /><span asp-validation-for="Naziv" class="text-danger small"></span></div>
<div class="row">
  <div class="col-md-6 mb-3"><label asp-for="BrojSobe" class="form-label fw-semibold"></label><input asp-for="BrojSobe" class="form-control" type="number" /></div>
  <div class="col-md-6 mb-3"><label asp-for="CijenaPoNoci" class="form-label fw-semibold"></label><div class="input-group"><input asp-for="CijenaPoNoci" class="form-control" type="number" step="0.50" /><span class="input-group-text">€</span></div></div>
</div>
<div class="mb-3"><label asp-for="TipSobe" class="form-label fw-semibold"></label><select asp-for="TipSobe" asp-items="Html.GetEnumSelectList<Hostel.MVC.Models.TipSobe>()" class="form-select"></select></div>
<div class="mb-3"><label asp-for="Opis" class="form-label fw-semibold"></label><textarea asp-for="Opis" class="form-control" rows="3"></textarea></div>
<div class="mb-4"><div class="form-check form-switch"><input asp-for="Dostupan" class="form-check-input" type="checkbox" role="switch" /><label asp-for="Dostupan" class="form-check-label fw-semibold">Dostupan za rezervaciju</label></div></div>

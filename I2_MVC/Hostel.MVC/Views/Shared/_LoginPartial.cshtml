@using Microsoft.AspNetCore.Identity
@inject SignInManager<Microsoft.AspNetCore.Identity.IdentityUser> SignInManager
@inject UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager
<ul class="navbar-nav">
  @if (SignInManager.IsSignedIn(User)) {
    <li class="nav-item"><span class="nav-link text-warning"><i class="bi bi-person-circle me-1"></i>@UserManager.GetUserName(User)</span></li>
    <li class="nav-item"><form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index","Home",new{area=""})" method="post"><button type="submit" class="btn btn-sm btn-outline-light ms-2"><i class="bi bi-box-arrow-right me-1"></i>Odjava</button></form></li>
  } else {
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus me-1"></i>Registracija</a></li>
    <li class="nav-item"><a class="btn btn-sm btn-warning ms-2" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i>Prijava</a></li>
  }
</ul>

<footer class="hostel-footer mt-5">
  <div class="container">
    <div class="row">
      <div class="col-md-4"><h5><i class="bi bi-building me-2"></i>HostelHub MVC</h5><p class="text-muted small">ASP.NET Core MVC aplikacija.</p></div>
      <div class="col-md-4"><h6>Brzi linkovi</h6><ul class="list-unstyled small">
        <li><a asp-controller="Lezaj" asp-action="Index" class="footer-link"><i class="bi bi-bed me-1"></i>Ležajevi</a></li>
        <li><a asp-controller="Rezervacija" asp-action="Index" class="footer-link"><i class="bi bi-calendar me-1"></i>Rezervacije</a></li>
        <li><a asp-controller="Rezervacija" asp-action="Aktivne" class="footer-link"><i class="bi bi-check-circle me-1"></i>Aktivne rezervacije</a></li>
      </ul></div>
      <div class="col-md-4"><h6>Kontakt</h6><p class="text-muted small"><i class="bi bi-envelope me-1"></i> info@hostelhub.hr</p></div>
    </div>
    <hr class="footer-divider"/>
    <p class="text-center text-muted small mb-0">&copy; @DateTime.Now.Year HostelHub - Veleučilište u Bjelovaru</p>
  </div>
</footer>

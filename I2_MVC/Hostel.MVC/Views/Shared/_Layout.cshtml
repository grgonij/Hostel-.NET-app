<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - HostelHub MVC</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
  <nav class="navbar navbar-expand-lg hostel-navbar">
    <div class="container">
      <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-building me-2"></i><strong>HostelHub</strong> <span class="badge bg-warning text-dark ms-1 small">MVC</span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill me-1"></i>Početna</a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-bed-fill me-1"></i>Ležajevi</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="Lezaj" asp-action="Index"><i class="bi bi-list me-2"></i>Svi ležajevi</a></li>
              <li><a class="dropdown-item" asp-controller="Lezaj" asp-action="Dostupni"><i class="bi bi-check-circle me-2"></i>Dostupni</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" asp-controller="Lezaj" asp-action="PoTipu" asp-route-tip="Privatna"><i class="bi bi-person me-2"></i>Privatne sobe</a></li>
              <li><a class="dropdown-item" asp-controller="Lezaj" asp-action="PoTipu" asp-route-tip="Zajednička"><i class="bi bi-people me-2"></i>Zajedničke sobe</a></li>
              @if (User.Identity?.IsAuthenticated == true) {
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Lezaj" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Dodaj ležaj</a></li>
              }
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-calendar-check-fill me-1"></i>Rezervacije</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="Rezervacija" asp-action="Index"><i class="bi bi-list me-2"></i>Sve rezervacije</a></li>
              <li><a class="dropdown-item" asp-controller="Rezervacija" asp-action="Aktivne"><i class="bi bi-check-circle me-2"></i>Aktivne</a></li>
              <li><a class="dropdown-item" asp-controller="Rezervacija" asp-action="Nadolazece"><i class="bi bi-clock me-2"></i>Nadolazeće</a></li>
              @if (User.Identity?.IsAuthenticated == true) {
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Rezervacija" asp-action="Moje"><i class="bi bi-person-check me-2"></i>Moje rezervacije</a></li>
                <li><a class="dropdown-item" asp-controller="Rezervacija" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Nova rezervacija</a></li>
              }
            </ul>
          </li>
        </ul>
        <partial name="_LoginPartial" />
      </div>
    </div>
  </nav>
</header>
<main class="py-4">
  <div class="container">
    @if (TempData["Poruka"] != null) {
      <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Poruka"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
  </div>
</main>
<partial name="_FooterPartial" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using Hostel.MVC.Helpers
@model IEnumerable<Hostel.MVC.Models.Lezaj>
@{ ViewData["Title"] = "Ležajevi"; string naslov = ViewBag.Naslov ?? "Svi ležajevi"; }
<div class="page-header d-flex justify-content-between align-items-center">
  <h2><i class="bi bi-bed-fill me-2"></i>@naslov</h2>
  @if(User.Identity?.IsAuthenticated==true){<a asp-action="Create" class="btn btn-hostel"><i class="bi bi-plus-lg me-1"></i>Dodaj ležaj</a>}
</div>
<div class="row g-3">
  @foreach (var lezaj in Model) {
    <div class="col-md-4"><div class="card lezaj-kartica h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2"><h5 class="card-title mb-0">@lezaj.Naziv</h5>@Html.DostupnostIkona(lezaj.Dostupan)</div>
        <p class="text-muted small mb-1"><i class="bi bi-door-open me-1"></i>Soba @lezaj.BrojSobe &nbsp;|&nbsp; @Html.TipSobeBadge(lezaj.TipSobe)</p>
        @if(!string.IsNullOrEmpty(lezaj.Opis)){<p class="card-text small">@lezaj.Opis</p>}
        <p>@Html.FormatCijena(lezaj.CijenaPoNoci) <span class="text-muted small">/ noć</span></p>
      </div>
      <div class="card-footer bg-transparent d-flex gap-2 flex-wrap">
        <a asp-action="Details" asp-route-id="@lezaj.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Detalji</a>
        @if(User.Identity?.IsAuthenticated==true){
          <a asp-action="Edit" asp-route-id="@lezaj.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Uredi</a>
          <a asp-action="Delete" asp-route-id="@lezaj.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Briši</a>
        }
        @if(lezaj.Dostupan){<a asp-controller="Rezervacija" asp-action="Create" asp-route-lezajId="@lezaj.Id" class="btn btn-sm btn-success ms-auto"><i class="bi bi-calendar-plus me-1"></i>Rezerviraj</a>}
      </div>
    </div></div>
  }
</div>
@if (!Model.Any()) { <div class="alert alert-hostel"><i class="bi bi-info-circle me-2"></i>Nema ležajeva za prikaz.</div> }

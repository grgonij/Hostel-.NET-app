@page
@model Hostel.RazorPages.Pages.Lezajevi.SortiraniModel
@{ ViewData["Title"] = "Sortirani ležajevi"; }
<div class="page-header d-flex justify-content-between align-items-center">
  <h2><i class="bi bi-sort-alpha-down me-2"></i>Sortirani ležajevi</h2>
  <div>
    <a asp-page="Sortirani" asp-route-kljuc="naziv" class="btn btn-sm btn-outline-primary @(Model.Kljuc == "naziv" ? "active" : "")">Naziv</a>
    <a asp-page="Sortirani" asp-route-kljuc="cijena" class="btn btn-sm btn-outline-primary @(Model.Kljuc == "cijena" ? "active" : "")">Cijena</a>
    <a asp-page="Sortirani" asp-route-kljuc="soba" class="btn btn-sm btn-outline-primary @(Model.Kljuc == "soba" ? "active" : "")">Soba</a>
  </div>
</div>
<div class="table-responsive"><table class="table table-hover">
  <thead class="table-hostel"><tr><th>#</th><th>Naziv</th><th>Soba</th><th>Tip</th><th>Cijena/noć</th><th>Status</th><th>Dodano</th><th>Akcije</th></tr></thead>
  <tbody>
    @{ int i = 1; }
    @foreach (var lezaj in Model.Lezaji) {
      <tr><td class="text-muted">@i++</td><td><strong>@lezaj.Naziv</strong></td><td>@lezaj.BrojSobe</td>
      <td><span class="badge badge-tip">@lezaj.TipSobe</span></td>
      <td class="text-primary fw-semibold">@lezaj.CijenaPoNoci.ToString("F2") €</td>
      <td>@if(lezaj.Dostupan){<span class="badge bg-success">Dostupan</span>}else{<span class="badge bg-danger">Zauzet</span>}</td>
      <td class="text-muted small">@lezaj.DatumDodavanja.ToString("dd.MM.yyyy")</td>
      <td>
        <a asp-page="Details" asp-route-id="@lezaj.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
        <a asp-page="Edit" asp-route-id="@lezaj.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
        <a asp-page="Delete" asp-route-id="@lezaj.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
      </td></tr>
    }
  </tbody>
</table></div>

@page "{id:int}"
@model Hostel.RazorPages.Pages.Lezajevi.DetailsModel
@{ ViewData["Title"] = "Detalji ležaja"; }
<div class="page-header d-flex justify-content-between align-items-center">
  <h2><i class="bi bi-info-circle me-2"></i>Detalji ležaja</h2>
  <div class="d-flex gap-2">
    <a asp-page="Edit" asp-route-id="@Model.Lezaj!.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil me-1"></i>Uredi</a>
    <a asp-page="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i>Natrag</a>
  </div>
</div>
@if (Model.Lezaj != null) {
<div class="row g-4">
  <div class="col-md-5"><div class="card shadow-sm">
    <div class="card-header" style="background: var(--hostel-primary); color: white;"><h5 class="mb-0">@Model.Lezaj.Naziv</h5></div>
    <div class="card-body">
      <table class="table table-borderless">
        <tr><td class="fw-semibold text-muted">Broj sobe</td><td>@Model.Lezaj.BrojSobe</td></tr>
        <tr><td class="fw-semibold text-muted">Tip sobe</td><td>@Model.Lezaj.TipSobe</td></tr>
        <tr><td class="fw-semibold text-muted">Cijena</td><td><strong class="text-primary">@Model.Lezaj.CijenaPoNoci.ToString("F2") €</strong> / noć</td></tr>
        <tr><td class="fw-semibold text-muted">Status</td><td>@if(Model.Lezaj.Dostupan){<span class="badge bg-success">Dostupan</span>}else{<span class="badge bg-danger">Zauzet</span>}</td></tr>
        <tr><td class="fw-semibold text-muted">Dodan</td><td>@Model.Lezaj.DatumDodavanja.ToString("dd.MM.yyyy")</td></tr>
      </table>
      @if (!string.IsNullOrEmpty(Model.Lezaj.Opis)) { <p class="text-muted small">@Model.Lezaj.Opis</p> }
    </div>
    <div class="card-footer"><a asp-page="/Rezervacije/Create" asp-route-lezajId="@Model.Lezaj.Id" class="btn btn-hostel w-100"><i class="bi bi-calendar-plus me-1"></i>Rezerviraj ovaj ležaj</a></div>
  </div></div>
  <div class="col-md-7">
    <h5><i class="bi bi-calendar-check me-2"></i>Rezervacije za ovaj ležaj</h5>
    @if (Model.Rezervacije.Any()) {
      <table class="table table-hover"><thead class="table-hostel"><tr><th>Gost</th><th>Prijava</th><th>Odjava</th><th>Status</th></tr></thead>
      <tbody>@foreach (var rez in Model.Rezervacije) {
        <tr><td>@rez.ImeGosta</td><td>@rez.DatumPrijave.ToString("dd.MM.yyyy")</td><td>@rez.DatumOdjave.ToString("dd.MM.yyyy")</td>
        <td><span class="badge @(rez.Status == Hostel.RazorPages.Models.StatusRezervacije.Aktivna ? "bg-success" : "bg-secondary")">@rez.Status</span></td></tr>
      }</tbody></table>
    } else { <div class="alert alert-hostel"><i class="bi bi-info-circle me-2"></i>Nema rezervacija za ovaj ležaj.</div> }
  </div>
</div>
}

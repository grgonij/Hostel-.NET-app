<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hostel Rezervacije</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
  <nav class="navbar navbar-expand-lg hostel-navbar">
    <div class="container">
      <a class="navbar-brand" asp-page="/Index">
        <img src="~/images/logo.svg" alt="Logo" width="36" height="36" />
        <span>Hostel<strong>Hub</strong></span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" asp-page="/Index"><i class="bi bi-house-fill me-1"></i>Početna</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Lezajevi/Index"><i class="bi bi-bed-fill me-1"></i>Ležajevi</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Lezajevi/Filtriraj"><i class="bi bi-funnel-fill me-1"></i>Pretraži</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Lezajevi/Sortirani"><i class="bi bi-sort-alpha-down me-1"></i>Sortirani</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Rezervacije/Index"><i class="bi bi-calendar-check-fill me-1"></i>Rezervacije</a></li>
        </ul>
      </div>
    </div>
  </nav>
</header>
<main class="py-4">
  <div class="container">
    @RenderBody()
  </div>
</main>
<partial name="_Footer" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page
@model Hostel.RazorPages.Pages.Rezervacije.IndexModel
@{ ViewData["Title"] = "Rezervacije"; }
<div class="page-header d-flex justify-content-between align-items-center">
  <h2><i class="bi bi-calendar-check-fill me-2"></i>Sve rezervacije</h2>
  <a asp-page="Create" class="btn btn-hostel"><i class="bi bi-plus-lg me-1"></i>Nova rezervacija</a>
</div>
@if (TempData["Poruka"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Poruka"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
<div class="table-responsive"><table class="table table-hover">
  <thead class="table-hostel"><tr><th>Gost</th><th>E-mail</th><th>Ležaj</th><th>Prijava</th><th>Odjava</th><th>Status</th><th>Akcije</th></tr></thead>
  <tbody>
    @foreach (var rez in Model.Rezervacije) {
      <tr><td><strong>@rez.ImeGosta</strong></td><td class="small text-muted">@rez.Email</td><td>@rez.Lezaj?.Naziv</td>
      <td>@rez.DatumPrijave.ToString("dd.MM.yyyy")</td><td>@rez.DatumOdjave.ToString("dd.MM.yyyy")</td>
      <td><span class="badge @(rez.Status == Hostel.RazorPages.Models.StatusRezervacije.Aktivna ? "bg-success" : rez.Status == Hostel.RazorPages.Models.StatusRezervacije.Otkazana ? "bg-danger" : "bg-secondary")">@rez.Status</span></td>
      <td>
        <a asp-page="Edit" asp-route-id="@rez.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
        <a asp-page="Delete" asp-route-id="@rez.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
      </td></tr>
    }
  </tbody>
</table></div>
@if (!Model.Rezervacije.Any()) { <div class="alert alert-hostel"><i class="bi bi-info-circle me-2"></i>Nema unesenih rezervacija. <a asp-page="Create" class="alert-link">Dodajte prvu rezervaciju!</a></div> }
